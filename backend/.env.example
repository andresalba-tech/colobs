# Clave de API de Maton Gateway (obtenida en https://maton.ai/settings)
MATON_API_KEY=

# Versión de la API de LinkedIn requerida por el Gateway (formato YYYYMM)
LINKEDIN_VERSION=202608

# URL base del gateway de Maton
MATON_GATEWAY_URL=https://gateway.maton.ai/linkedin

# Clave de autenticación para endpoint privado de analíticas de visitantes
ADMIN_API_KEY=tu_clave_secreta_aqui
